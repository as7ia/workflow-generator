  <bpmn:process id="Process_1" name="Workflow" isExecutable="true">
    <bpmn:startEvent id="start_1" name="Début de la demande" />
    <bpmn:userTask id="task_employee" name="Soumission de la demande de congé" />
    <bpmn:exclusiveGateway id="gateway_decision" name="Décision du manager" />
    <bpmn:serviceTask id="task_hr_approved" name="Enregistrement du congé par RH" />
    <bpmn:sendTask id="task_employee_approved" name="Notification de confirmation" />
    <bpmn:sendTask id="task_employee_rejected" name="Notification de refus" />
    <bpmn:endEvent id="end_1" name="Fin du processus" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_1" targetRef="task_employee" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_employee" targetRef="gateway_decision" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="gateway_decision" targetRef="task_hr_approved" name="approuvée">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approuvée</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_4" sourceRef="gateway_decision" targetRef="task_employee_rejected" name="refusée">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refusée</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_5" sourceRef="task_hr_approved" targetRef="task_employee_approved" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="task_employee_approved" targetRef="end_1" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="task_employee_rejected" targetRef="end_1" />
  </bpmn:process>
