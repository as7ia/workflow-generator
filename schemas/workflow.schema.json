{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/workflow.schema.json",
  "title": "Canonical BPMN Workflow v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "processes", "participants", "lanes", "nodes", "flows", "messageFlows", "ambiguities"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "processes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/process" } },
    "participants": { "type": "array", "items": { "$ref": "#/$defs/participant" } },
    "lanes": { "type": "array", "items": { "$ref": "#/$defs/lane" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "flows": { "type": "array", "items": { "$ref": "#/$defs/sequenceFlow" } },
    "messageFlows": { "type": "array", "items": { "$ref": "#/$defs/messageFlow" } },
    "ambiguities": { "type": "array", "items": { "$ref": "#/$defs/ambiguity" } }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
    "nullableIdentifier": {
      "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "executable", "properties"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "executable": { "type": "boolean" },
        "properties": { "type": "object" }
      }
    },
    "nodeProperties": {
      "type": "object",
      "properties": {
        "timer": { "$ref": "#/$defs/timerDefinition" }
      },
      "additionalProperties": true
    },
    "timerDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string", "enum": ["duration", "date", "cycle"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "processRef", "properties"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "processRef": { "$ref": "#/$defs/identifier" },
        "properties": { "type": "object" }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "processRef", "participantRef", "properties"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "processRef": { "$ref": "#/$defs/identifier" },
        "participantRef": { "$ref": "#/$defs/nullableIdentifier" },
        "properties": { "type": "object" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "processRef", "participantRef", "laneRef", "actor", "properties"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": {
          "type": "string",
          "enum": [
            "startEvent", "endEvent", "userTask", "serviceTask", "manualTask",
            "scriptTask", "businessRuleTask", "sendTask", "receiveTask",
            "exclusiveGateway", "parallelGateway", "inclusiveGateway",
            "eventBasedGateway", "subProcess", "intermediateCatchEvent",
            "intermediateThrowEvent"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "processRef": { "$ref": "#/$defs/identifier" },
        "participantRef": { "$ref": "#/$defs/nullableIdentifier" },
        "laneRef": { "$ref": "#/$defs/nullableIdentifier" },
        "actor": { "type": ["string", "null"] },
        "properties": { "$ref": "#/$defs/nodeProperties" }
      }
    },
    "sequenceFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "processRef", "condition", "isDefault", "properties"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string" },
        "source": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/identifier" },
        "processRef": { "$ref": "#/$defs/identifier" },
        "condition": { "type": ["string", "null"] },
        "isDefault": { "type": "boolean" },
        "properties": { "type": "object" }
      }
    },
    "messageFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "properties"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string" },
        "source": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/identifier" },
        "properties": { "type": "object" }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "message", "relatedNode", "severity"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "message": { "type": "string", "minLength": 1 },
        "relatedNode": { "$ref": "#/$defs/nullableIdentifier" },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] }
      }
    }
  }
}
