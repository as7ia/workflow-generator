{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/workflow.schema.json",
  "title": "Intermediate BPMN Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "process",
    "participants",
    "nodes",
    "flows",
    "ambiguities"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "process": {
      "$ref": "#/$defs/process"
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/participant"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguity"
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lane"
      }
    },
    "messageFlows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/messageFlow"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "executable"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "human",
            "system",
            "externalOrganization"
          ]
        },
        "nodeRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lane"
          }
        },
        "properties": {
          "type": "object"
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "nodeRefs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "nodeRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "properties": {
          "type": "object"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "actor",
        "properties"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "enum": [
            "startEvent",
            "endEvent",
            "userTask",
            "serviceTask",
            "exclusiveGateway",
            "parallelGateway",
            "inclusiveGateway",
            "eventBasedGateway",
            "subProcess",
            "intermediateCatchEvent",
            "intermediateThrowEvent",
            "timerEvent"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "properties": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "userTask"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "actor": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "startEvent",
                  "endEvent",
                  "exclusiveGateway",
                  "parallelGateway",
                  "inclusiveGateway",
                  "eventBasedGateway"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "actor": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "condition",
        "isDefault"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/identifier"
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "isDefault": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "sequenceFlow",
            "sequence"
          ]
        },
        "properties": {
          "type": "object"
        }
      }
    },
    "messageFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/identifier"
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "isDefault": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "messageFlow",
            "message"
          ]
        },
        "properties": {
          "type": "object"
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "message",
        "relatedNode",
        "severity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "relatedNode": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        }
      }
    }
  }
}
